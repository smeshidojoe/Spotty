# --- Python ----------------------------------------------------------------- #
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/

# Окружения
.venv/
venv/
env/
ENV/

# Кеши инструментов
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Сборка ----------------------------------------------------------------- #
# PyInstaller: build/ и dist/ пересобираются, .spec — нет, его держим в репозитории.
build/
dist/

# Inno Setup
installer_output/
Output/

# Папка самообновления создаётся рядом с exe, в разработке — в корне проекта.
_update/

# --- Данные программы -------------------------------------------------------- #
# Настройки и история лежат в %APPDATA%\Spotty, кэш — в %LOCALAPPDATA%\Spotty,
# сюда попасть не должны, но на случай запуска с переносными путями:
*.log
config.json
usage.json
commands.json

# --- Редакторы и ОС ---------------------------------------------------------- #
.vscode/
.idea/
*.code-workspace
*.swp
*~
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# --- Черновики --------------------------------------------------------------- #
scratch/
tmp/
*.bak
